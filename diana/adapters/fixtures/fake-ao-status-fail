#!/usr/bin/env bash
# Fake `ao`: session get always fails, as AO's real CLI does for an unknown
# session id (verified against the real 0.12.10 daemon: `Unknown session
# (SESSION_NOT_FOUND)`, exit 1).
set -euo pipefail
case "$1" in
  session)
    if [ "$2" = "get" ]; then
      echo "Unknown session (SESSION_NOT_FOUND) [request fake/000000]" >&2
      exit 1
    fi
    echo "fake-ao-status-fail: unhandled session subcommand: $*" >&2
    exit 1
    ;;
  *)
    echo "fake-ao-status-fail: unhandled command: $*" >&2
    exit 1
    ;;
esac
