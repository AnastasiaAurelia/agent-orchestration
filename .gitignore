# Keep this public repo scoped to the reusable Diana base.
# The working directory may contain local reference repos and scratch projects;
# ignore everything by default, then allow only the intended release files.

*

!.gitignore
!AGENTS.md
!MEMORY.md
!.claude/
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/check-careful.sh
!.github/
!.github/workflows/
!.github/workflows/diana-gate.yml
!.github/CODEOWNERS
!.github/pull_request_template.md
!README.md
!install.sh
!verify.sh
!uninstall.sh

!diana/
!diana/CLAUDE.md
!diana/skills/
!diana/skills/*.md
!diana/commands/
!diana/commands/*.md
!diana/hooks/
!diana/hooks/hooks.json
!diana/hooks/check-careful.sh
!diana/hooks/cost-report.md
!diana/hooks/README.md
!diana/memory/
!diana/memory/README.md
!diana/memory/decisions.md
!diana/memory/known-issues.md
!diana/memory/advisor-log.md
!diana/memory/learned-rules.md
!diana/governance/
!diana/governance/risk-tiers.md
!diana/gate/
!diana/gate/*.py
!diana/gate/*.md
!diana/gate/*.sh
!diana/gate/fixtures/
!diana/gate/fixtures/*.json
!diana/ci/
!diana/ci/*.py
!diana/ci/*.sh
!diana/ci/*.md
!diana/preflight/
!diana/preflight/*.py
!diana/preflight/*.md
!diana/preflight/*.sh
!diana/preflight/fixtures/
!diana/preflight/fixtures/*.json
!diana/templates/
!diana/templates/*.md

# Explicit reminders for common files that must never be published here.
.env
.env.*
node_modules/
references/
scratch/
tmp/
temp/
*.bak
*.bak.*
*.swp
*.swo
.DS_Store
